<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="_amendment_request_defs"
                   targetNamespace="https://bank.com/bpmn/amendments"
                   exporter="Manual"
                   exporterVersion="1.0">

  <bpmn2:itemDefinition id="_itemRequest" structureRef="com.bank.amendments.model.AmendmentRequest"/>
  <bpmn2:itemDefinition id="_itemString" structureRef="String"/>
  <bpmn2:itemDefinition id="_itemBoolean" structureRef="Boolean"/>
  <bpmn2:itemDefinition id="_itemInt" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_itemItem" structureRef="com.bank.amendments.model.AmendmentItem"/>
  <bpmn2:itemDefinition id="_itemMap" structureRef="java.util.Map"/>
  <bpmn2:itemDefinition id="_itemList" structureRef="com.bank.amendments.model.AmendmentItem" isCollection="true"/>
  <bpmn2:itemDefinition id="_itemExecutionPlan" structureRef="com.bank.amendments.model.ExecutionPlan"/>

  <bpmn2:message id="_msg_document" name="ExtraDocumentSubmitted" itemRef="_itemString"/>
  <bpmn2:message id="_msg_verification" name="AdditionalVerificationRequired" itemRef="_itemString"/>
  <bpmn2:message id="_msg_cancel" name="AmendmentCancelled" itemRef="_itemString"/>
  <bpmn2:signal id="_sig_sla" name="SlaBreached"/>

  <bpmn2:process id="amendment_request"
                 name="Amendment Request"
                 isExecutable="true"
                 processType="Public">

    <bpmn2:property id="request" itemSubjectRef="_itemRequest" name="request">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="accountId" itemSubjectRef="_itemString" name="accountId"/>
    <bpmn2:property id="requestId" itemSubjectRef="_itemString" name="requestId">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="cancelled" itemSubjectRef="_itemBoolean" name="cancelled"/>
    <bpmn2:property id="amendmentType" itemSubjectRef="_itemString" name="amendmentType">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="accountStatus" itemSubjectRef="_itemString" name="accountStatus">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="requestorIsParty" itemSubjectRef="_itemBoolean" name="requestorIsParty">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="mandatePermits" itemSubjectRef="_itemBoolean" name="mandatePermits">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="channel" itemSubjectRef="_itemString" name="channel">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="screeningOutcome" itemSubjectRef="_itemString" name="screeningOutcome">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="inFlightAmendment" itemSubjectRef="_itemBoolean" name="inFlightAmendment">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="accountIsJoint" itemSubjectRef="_itemBoolean" name="accountIsJoint">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="addressVerified" itemSubjectRef="_itemBoolean" name="addressVerified"/>
    <bpmn2:property id="rescreenOutcome" itemSubjectRef="_itemString" name="rescreenOutcome"/>
    <bpmn2:property id="allConsentsGranted" itemSubjectRef="_itemBoolean" name="allConsentsGranted"/>
    <bpmn2:property id="nameChangeReason" itemSubjectRef="_itemString" name="nameChangeReason"/>
    <bpmn2:property id="otherPartyStatus" itemSubjectRef="_itemString" name="otherPartyStatus"/>
    <bpmn2:property id="jointLiabilities" itemSubjectRef="_itemBoolean" name="jointLiabilities"/>
    <bpmn2:property id="remainingPartyEligible" itemSubjectRef="_itemBoolean" name="remainingPartyEligible"/>
    <bpmn2:property id="riskBand" itemSubjectRef="_itemString" name="riskBand">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="admissibility" itemSubjectRef="_itemMap" name="admissibility">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[output]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="amendmentItems" itemSubjectRef="_itemList" name="amendmentItems"/>
    <bpmn2:property id="itemType" itemSubjectRef="_itemString" name="itemType"/>
    <bpmn2:property id="isCoa" itemSubjectRef="_itemBoolean" name="isCoa"/>
    <bpmn2:property id="isCon" itemSubjectRef="_itemBoolean" name="isCon"/>
    <bpmn2:property id="isJointToSole" itemSubjectRef="_itemBoolean" name="isJointToSole"/>
    <bpmn2:property id="anyPermitted" itemSubjectRef="_itemBoolean" name="anyPermitted"/>
    <bpmn2:property id="permittedCount" itemSubjectRef="_itemInt" name="permittedCount">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="includesJointToSole" itemSubjectRef="_itemBoolean" name="includesJointToSole">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="includesCon" itemSubjectRef="_itemBoolean" name="includesCon">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="includesCoa" itemSubjectRef="_itemBoolean" name="includesCoa">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="ExecutionPlan" itemSubjectRef="_itemExecutionPlan" name="ExecutionPlan">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[output]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>

    <bpmn2:startEvent id="start" name="Request submitted">
      <bpmn2:outgoing>f1</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:task id="task_intake"
                       name="Load account and verify identity" drools:taskName="AccountIntakeTask">
            <bpmn2:ioSpecification>
                <bpmn2:dataInput id="_di_intake" itemSubjectRef="_itemRequest" name="request"/>
        <bpmn2:dataInput id="_di_intake_requestId" name="requestId"/>
        <bpmn2:dataInput id="_di_intake_amendmentType" name="amendmentType"/>
        <bpmn2:dataInput id="_di_intake_accountStatus" name="accountStatus"/>
        <bpmn2:dataInput id="_di_intake_requestorIsParty" name="requestorIsParty"/>
        <bpmn2:dataInput id="_di_intake_mandatePermits" name="mandatePermits"/>
        <bpmn2:dataInput id="_di_intake_channel" name="channel"/>
        <bpmn2:dataInput id="_di_intake_screeningOutcome" name="screeningOutcome"/>
        <bpmn2:dataInput id="_di_intake_inFlightAmendment" name="inFlightAmendment"/>
        <bpmn2:dataInput id="_di_intake_accountIsJoint" name="accountIsJoint"/>
        <bpmn2:dataInput id="_di_intake_riskBand" name="riskBand"/>
        <bpmn2:dataInput id="_di_intake_addressVerified" name="addressVerified"/>
        <bpmn2:dataInput id="_di_intake_rescreenOutcome" name="rescreenOutcome"/>
        <bpmn2:dataInput id="_di_intake_allConsentsGranted" name="allConsentsGranted"/>
        <bpmn2:dataInput id="_di_intake_nameChangeReason" name="nameChangeReason"/>
        <bpmn2:dataInput id="_di_intake_otherPartyStatus" name="otherPartyStatus"/>
        <bpmn2:dataInput id="_di_intake_jointLiabilities" name="jointLiabilities"/>
        <bpmn2:dataInput id="_di_intake_remainingPartyEligible" name="remainingPartyEligible"/>
        <bpmn2:dataOutput id="_do_intake" itemSubjectRef="_itemRequest" name="request"/>
        <bpmn2:dataOutput id="_do_intake_accountId" name="accountId"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_di_intake</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_requestId</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_amendmentType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_accountStatus</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_requestorIsParty</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_mandatePermits</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_channel</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_screeningOutcome</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_inFlightAmendment</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_accountIsJoint</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_riskBand</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_addressVerified</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_rescreenOutcome</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_allConsentsGranted</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_nameChangeReason</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_otherPartyStatus</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_jointLiabilities</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_intake_remainingPartyEligible</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_intake</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_intake_accountId</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:incoming>f1</bpmn2:incoming>
      <bpmn2:outgoing>f2</bpmn2:outgoing>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>requestId</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_requestId</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>amendmentType</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_amendmentType</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>accountStatus</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_accountStatus</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>requestorIsParty</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_requestorIsParty</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>mandatePermits</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_mandatePermits</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>channel</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_channel</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>screeningOutcome</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_screeningOutcome</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>inFlightAmendment</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_inFlightAmendment</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>accountIsJoint</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_accountIsJoint</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>riskBand</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_riskBand</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>addressVerified</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_addressVerified</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>rescreenOutcome</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_rescreenOutcome</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>allConsentsGranted</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_allConsentsGranted</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>nameChangeReason</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_nameChangeReason</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>otherPartyStatus</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_otherPartyStatus</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>jointLiabilities</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_jointLiabilities</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>remainingPartyEligible</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake_remainingPartyEligible</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_dia_intake">
        <bpmn2:sourceRef>request</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_doa_intake">
        <bpmn2:sourceRef>_do_intake</bpmn2:sourceRef>
        <bpmn2:targetRef>request</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_intake_accountId</bpmn2:sourceRef>
        <bpmn2:targetRef>accountId</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>

    <bpmn2:task id="task_screening"
                       name="Sanctions and PEP screening" drools:taskName="SanctionsScreeningTask">
            <bpmn2:ioSpecification>
                <bpmn2:dataInput id="_di_scr" itemSubjectRef="_itemRequest" name="request"/>
        <bpmn2:dataOutput id="_do_scr" itemSubjectRef="_itemRequest" name="request"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_di_scr</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_scr</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:incoming>f2</bpmn2:incoming>
      <bpmn2:outgoing>f3</bpmn2:outgoing>
      
      <bpmn2:dataInputAssociation id="_dia_scr">
        <bpmn2:sourceRef>request</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_scr</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_doa_scr">
        <bpmn2:sourceRef>_do_scr</bpmn2:sourceRef>
        <bpmn2:targetRef>request</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>

    <bpmn2:businessRuleTask id="task_admissibility"
                            name="Assess admissibility"
                            implementation="http://www.jboss.org/drools/dmn">
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_di_task_admissibility_0" name="namespace"/>
        <bpmn2:dataInput id="_di_task_admissibility_1" name="model"/>
        <bpmn2:dataInput id="_di_task_admissibility_2" name="decision"/>
        <bpmn2:dataInput id="_di_adm_amendmentType" name="amendmentType"/>
        <bpmn2:dataInput id="_di_adm_accountStatus" name="accountStatus"/>
        <bpmn2:dataInput id="_di_adm_requestorIsParty" name="requestorIsParty"/>
        <bpmn2:dataInput id="_di_adm_mandatePermits" name="mandatePermits"/>
        <bpmn2:dataInput id="_di_adm_channel" name="channel"/>
        <bpmn2:dataInput id="_di_adm_screeningOutcome" name="screeningOutcome"/>
        <bpmn2:dataInput id="_di_adm_inFlightAmendment" name="inFlightAmendment"/>
        <bpmn2:dataInput id="_di_adm_accountIsJoint" name="accountIsJoint"/>
        <bpmn2:dataInput id="_di_adm_riskBand" name="riskBand"/>
        <bpmn2:dataOutput id="_do_adm_result" name="admissibility"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_di_task_admissibility_0</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_task_admissibility_1</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_task_admissibility_2</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_adm_amendmentType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_adm_accountStatus</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_adm_requestorIsParty</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_adm_mandatePermits</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_adm_channel</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_adm_screeningOutcome</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_adm_inFlightAmendment</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_adm_accountIsJoint</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_adm_riskBand</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_adm_result</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_task_admissibility_0</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[https://bank.com/dmn/amendments]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_task_admissibility_0]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_task_admissibility_1</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[AmendmentAdmissibility]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_task_admissibility_1]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_task_admissibility_2</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[Admissibility]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_task_admissibility_2]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>amendmentType</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_adm_amendmentType</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>accountStatus</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_adm_accountStatus</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>requestorIsParty</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_adm_requestorIsParty</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>mandatePermits</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_adm_mandatePermits</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>channel</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_adm_channel</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>screeningOutcome</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_adm_screeningOutcome</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>inFlightAmendment</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_adm_inFlightAmendment</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>accountIsJoint</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_adm_accountIsJoint</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>riskBand</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_adm_riskBand</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_adm_result</bpmn2:sourceRef>
        <bpmn2:targetRef>admissibility</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:incoming>f3</bpmn2:incoming>
      <bpmn2:outgoing>f4</bpmn2:outgoing>
    </bpmn2:businessRuleTask>

    <bpmn2:task id="task_derive_plan" name="Derive execution plan" drools:taskName="DerivePlanTask">
      <bpmn2:incoming>f4</bpmn2:incoming>
      <bpmn2:outgoing>f4b</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_di_task_derive_plan_request" name="request"/>
        <bpmn2:dataInput id="_di_task_derive_plan_admissibility" name="admissibility"/>
        <bpmn2:dataOutput id="_do_task_derive_plan_permittedCount" name="permittedCount"/>
        <bpmn2:dataOutput id="_do_task_derive_plan_includesCoa" name="includesCoa"/>
        <bpmn2:dataOutput id="_do_task_derive_plan_includesCon" name="includesCon"/>
        <bpmn2:dataOutput id="_do_task_derive_plan_includesJointToSole" name="includesJointToSole"/>
        <bpmn2:dataOutput id="_do_task_derive_plan_anyPermitted" name="anyPermitted"/>
        <bpmn2:dataOutput id="_do_task_derive_plan_amendmentItems" name="amendmentItems" itemSubjectRef="_itemList"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_di_task_derive_plan_request</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_task_derive_plan_admissibility</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_task_derive_plan_permittedCount</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_task_derive_plan_includesCoa</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_task_derive_plan_includesCon</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_task_derive_plan_includesJointToSole</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_task_derive_plan_anyPermitted</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_task_derive_plan_amendmentItems</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>request</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_task_derive_plan_request</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>admissibility</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_task_derive_plan_admissibility</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_task_derive_plan_permittedCount</bpmn2:sourceRef>
        <bpmn2:targetRef>permittedCount</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_task_derive_plan_includesCoa</bpmn2:sourceRef>
        <bpmn2:targetRef>includesCoa</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_task_derive_plan_includesCon</bpmn2:sourceRef>
        <bpmn2:targetRef>includesCon</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_task_derive_plan_includesJointToSole</bpmn2:sourceRef>
        <bpmn2:targetRef>includesJointToSole</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_task_derive_plan_anyPermitted</bpmn2:sourceRef>
        <bpmn2:targetRef>anyPermitted</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_task_derive_plan_amendmentItems</bpmn2:sourceRef>
        <bpmn2:targetRef>amendmentItems</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>

    <bpmn2:businessRuleTask id="task_sequencing"
                            name="Determine execution plan"
                            implementation="http://www.jboss.org/drools/dmn">
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_di_task_sequencing_0" name="namespace"/>
        <bpmn2:dataInput id="_di_task_sequencing_1" name="model"/>
        <bpmn2:dataInput id="_di_task_sequencing_2" name="decision"/>
        <bpmn2:dataInput id="_di_seq_permittedCount" name="permittedCount"/>
        <bpmn2:dataInput id="_di_seq_includesJointToSole" name="includesJointToSole"/>
        <bpmn2:dataInput id="_di_seq_includesCon" name="includesCon"/>
        <bpmn2:dataInput id="_di_seq_includesCoa" name="includesCoa"/>
        <bpmn2:dataOutput id="_do_seq_result" name="ExecutionPlan"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_di_task_sequencing_0</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_task_sequencing_1</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_task_sequencing_2</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_seq_permittedCount</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_seq_includesJointToSole</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_seq_includesCon</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_seq_includesCoa</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_seq_result</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_task_sequencing_0</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[https://bank.com/dmn/amendments]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_task_sequencing_0]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_task_sequencing_1</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[AmendmentSequencing]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_task_sequencing_1]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_task_sequencing_2</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[ExecutionPlan]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_task_sequencing_2]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>permittedCount</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_seq_permittedCount</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>includesJointToSole</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_seq_includesJointToSole</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>includesCon</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_seq_includesCon</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>includesCoa</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_seq_includesCoa</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_seq_result</bpmn2:sourceRef>
        <bpmn2:targetRef>ExecutionPlan</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:incoming>f4b</bpmn2:incoming>
      <bpmn2:outgoing>f5</bpmn2:outgoing>
    </bpmn2:businessRuleTask>

    <bpmn2:exclusiveGateway id="gw_any_permitted" name="Any permitted" gatewayDirection="Diverging">
      <bpmn2:incoming>f5</bpmn2:incoming>
      <bpmn2:outgoing>f6</bpmn2:outgoing>
      <bpmn2:outgoing>f_refuse</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:subProcess id="sub_dispatch" name="Execute permitted amendments">
      <bpmn2:incoming>f6</bpmn2:incoming>
      <bpmn2:outgoing>f7</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_ios_dispatch">
        <bpmn2:dataInput id="_di_dispatch_items" name="items"/>
        <bpmn2:inputSet id="_is_dispatch">
          <bpmn2:dataInputRefs>_di_dispatch_items</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="_os_dispatch"/>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>amendmentItems</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_dispatch_items</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:multiInstanceLoopCharacteristics id="_mi_dispatch" isSequential="false">
        <bpmn2:loopDataInputRef>_di_dispatch_items</bpmn2:loopDataInputRef>
        <bpmn2:inputDataItem id="item" name="item"/>
      </bpmn2:multiInstanceLoopCharacteristics>

      <bpmn2:startEvent id="sub_start">
        <bpmn2:outgoing>sf1</bpmn2:outgoing>
      </bpmn2:startEvent>

    <bpmn2:task id="sub_derive_type" name="Read amendment type" drools:taskName="ReadItemDetailTask">
      <bpmn2:incoming>sf1</bpmn2:incoming>
      <bpmn2:outgoing>sf1b</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_di_sub_derive_type_item" name="item"/>
        <bpmn2:dataOutput id="_do_sub_derive_type_itemType" name="itemType"/>
        <bpmn2:dataOutput id="_do_sub_derive_type_isCoa" name="isCoa"/>
        <bpmn2:dataOutput id="_do_sub_derive_type_isCon" name="isCon"/>
        <bpmn2:dataOutput id="_do_sub_derive_type_isJointToSole" name="isJointToSole"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_di_sub_derive_type_item</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_sub_derive_type_itemType</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_sub_derive_type_isCoa</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_sub_derive_type_isCon</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_sub_derive_type_isJointToSole</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>item</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_sub_derive_type_item</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_sub_derive_type_itemType</bpmn2:sourceRef>
        <bpmn2:targetRef>itemType</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_sub_derive_type_isCoa</bpmn2:sourceRef>
        <bpmn2:targetRef>isCoa</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_sub_derive_type_isCon</bpmn2:sourceRef>
        <bpmn2:targetRef>isCon</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_sub_derive_type_isJointToSole</bpmn2:sourceRef>
        <bpmn2:targetRef>isJointToSole</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>

      <bpmn2:exclusiveGateway id="gw_type" name="Amendment type" gatewayDirection="Diverging">
        <bpmn2:incoming>sf1b</bpmn2:incoming>
        <bpmn2:outgoing>sf_coa</bpmn2:outgoing>
        <bpmn2:outgoing>sf_con</bpmn2:outgoing>
        <bpmn2:outgoing>sf_jts</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>

      <bpmn2:callActivity id="call_coa" name="Change of address" calledElement="amendment_coa">
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="_di_call_coa_item" name="item"/>
          <bpmn2:dataInput id="_di_call_coa_accountId" name="accountId"/>
          <bpmn2:dataInput id="_di_call_coa_requestId" name="requestId"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>_di_call_coa_item</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>_di_call_coa_accountId</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>_di_call_coa_requestId</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet/>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>item</bpmn2:sourceRef>
          <bpmn2:targetRef>_di_call_coa_item</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>accountId</bpmn2:sourceRef>
          <bpmn2:targetRef>_di_call_coa_accountId</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>requestId</bpmn2:sourceRef>
          <bpmn2:targetRef>_di_call_coa_requestId</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:incoming>sf_coa</bpmn2:incoming>
        <bpmn2:outgoing>sf_coa_out</bpmn2:outgoing>
      </bpmn2:callActivity>

      <bpmn2:callActivity id="call_con" name="Change of name" calledElement="amendment_con">
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="_di_call_con_item" name="item"/>
          <bpmn2:dataInput id="_di_call_con_accountId" name="accountId"/>
          <bpmn2:dataInput id="_di_call_con_requestId" name="requestId"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>_di_call_con_item</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>_di_call_con_accountId</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>_di_call_con_requestId</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet/>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>item</bpmn2:sourceRef>
          <bpmn2:targetRef>_di_call_con_item</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>accountId</bpmn2:sourceRef>
          <bpmn2:targetRef>_di_call_con_accountId</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>requestId</bpmn2:sourceRef>
          <bpmn2:targetRef>_di_call_con_requestId</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:incoming>sf_con</bpmn2:incoming>
        <bpmn2:outgoing>sf_con_out</bpmn2:outgoing>
      </bpmn2:callActivity>

      <bpmn2:callActivity id="call_jts" name="Joint to sole" calledElement="amendment_joint_to_sole">
        <bpmn2:ioSpecification>
          <bpmn2:dataInput id="_di_call_jts_item" name="item"/>
          <bpmn2:dataInput id="_di_call_jts_accountId" name="accountId"/>
          <bpmn2:dataInput id="_di_call_jts_requestId" name="requestId"/>
          <bpmn2:inputSet>
            <bpmn2:dataInputRefs>_di_call_jts_item</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>_di_call_jts_accountId</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>_di_call_jts_requestId</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet/>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>item</bpmn2:sourceRef>
          <bpmn2:targetRef>_di_call_jts_item</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>accountId</bpmn2:sourceRef>
          <bpmn2:targetRef>_di_call_jts_accountId</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation>
          <bpmn2:sourceRef>requestId</bpmn2:sourceRef>
          <bpmn2:targetRef>_di_call_jts_requestId</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:incoming>sf_jts</bpmn2:incoming>
        <bpmn2:outgoing>sf_jts_out</bpmn2:outgoing>
      </bpmn2:callActivity>

      <bpmn2:exclusiveGateway id="gw_type_join" name="Join" gatewayDirection="Converging">
        <bpmn2:incoming>sf_coa_out</bpmn2:incoming>
        <bpmn2:incoming>sf_con_out</bpmn2:incoming>
        <bpmn2:incoming>sf_jts_out</bpmn2:incoming>
        <bpmn2:outgoing>sf_end</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>

      <bpmn2:endEvent id="sub_end">
        <bpmn2:incoming>sf_end</bpmn2:incoming>
      </bpmn2:endEvent>

      <bpmn2:sequenceFlow id="sf1" sourceRef="sub_start" targetRef="sub_derive_type"/>
      <bpmn2:sequenceFlow id="sf1b" sourceRef="sub_derive_type" targetRef="gw_type"/>
      <bpmn2:sequenceFlow id="sf_coa" sourceRef="gw_type" targetRef="call_coa">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">isCoa = true</bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="sf_con" sourceRef="gw_type" targetRef="call_con">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">isCon = true</bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="sf_jts" sourceRef="gw_type" targetRef="call_jts">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">isJointToSole = true</bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="sf_coa_out" sourceRef="call_coa" targetRef="gw_type_join"/>
      <bpmn2:sequenceFlow id="sf_con_out" sourceRef="call_con" targetRef="gw_type_join"/>
      <bpmn2:sequenceFlow id="sf_jts_out" sourceRef="call_jts" targetRef="gw_type_join"/>
      <bpmn2:sequenceFlow id="sf_end" sourceRef="gw_type_join" targetRef="sub_end"/>
    </bpmn2:subProcess>

    <bpmn2:exclusiveGateway id="gw_outcome_join" name="Join outcomes" gatewayDirection="Converging">
      <bpmn2:incoming>f7</bpmn2:incoming>
      <bpmn2:incoming>f_refuse</bpmn2:incoming>
      <bpmn2:outgoing>f_join_out</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:task id="task_aggregate"
                       name="Aggregate outcomes and notify customer" drools:taskName="CustomerNotificationTask">
      <bpmn2:incoming>f_join_out</bpmn2:incoming>
      <bpmn2:outgoing>f8</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:endEvent id="end" name="Request closed">
      <bpmn2:incoming>f8</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="f1" sourceRef="start" targetRef="task_intake"/>
    <bpmn2:sequenceFlow id="f2" sourceRef="task_intake" targetRef="task_screening"/>
    <bpmn2:sequenceFlow id="f3" sourceRef="task_screening" targetRef="task_admissibility"/>
    <bpmn2:sequenceFlow id="f4" sourceRef="task_admissibility" targetRef="task_derive_plan"/>
    <bpmn2:sequenceFlow id="f4b" sourceRef="task_derive_plan" targetRef="task_sequencing"/>
    <bpmn2:sequenceFlow id="f5" sourceRef="task_sequencing" targetRef="gw_any_permitted"/>
    <bpmn2:sequenceFlow id="f6" sourceRef="gw_any_permitted" targetRef="sub_dispatch">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">anyPermitted = true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="f_refuse" sourceRef="gw_any_permitted" targetRef="gw_outcome_join">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">anyPermitted = false</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="f7" sourceRef="sub_dispatch" targetRef="gw_outcome_join"/>
    <bpmn2:sequenceFlow id="f_join_out" sourceRef="gw_outcome_join" targetRef="task_aggregate"/>
    <bpmn2:sequenceFlow id="f8" sourceRef="task_aggregate" targetRef="end"/>

    <bpmn2:subProcess id="evsub_document" name="Extra document received" triggeredByEvent="true">
      <bpmn2:startEvent id="ev_doc_start" name="Document submitted" isInterrupting="false">
        <bpmn2:outgoing>ed1</bpmn2:outgoing>
        
        <bpmn2:dataOutput id="_do_ev_doc_start" name="_do_ev_doc_start"/>
        <bpmn2:dataOutputAssociation>
          <bpmn2:sourceRef>_do_ev_doc_start</bpmn2:sourceRef>
          <bpmn2:targetRef>requestId</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_ev_doc_start</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
        <bpmn2:messageEventDefinition id="_med_doc" messageRef="_msg_document"/>
      </bpmn2:startEvent>
      <bpmn2:task id="ev_doc_task" name="Attach and verify document" drools:taskName="DocumentVerificationTask">
        <bpmn2:incoming>ed1</bpmn2:incoming>
        <bpmn2:outgoing>ed2</bpmn2:outgoing>
    </bpmn2:task>
      <bpmn2:endEvent id="ev_doc_end">
        <bpmn2:incoming>ed2</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="ed1" sourceRef="ev_doc_start" targetRef="ev_doc_task"/>
      <bpmn2:sequenceFlow id="ed2" sourceRef="ev_doc_task" targetRef="ev_doc_end"/>
    </bpmn2:subProcess>

    <bpmn2:subProcess id="evsub_verification" name="Additional verification" triggeredByEvent="true">
      <bpmn2:startEvent id="ev_ver_start" name="Verification required" isInterrupting="false">
        <bpmn2:outgoing>ev1</bpmn2:outgoing>
        
        <bpmn2:dataOutput id="_do_ev_ver_start" name="_do_ev_ver_start"/>
        <bpmn2:dataOutputAssociation>
          <bpmn2:sourceRef>_do_ev_ver_start</bpmn2:sourceRef>
          <bpmn2:targetRef>requestId</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_ev_ver_start</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
        <bpmn2:messageEventDefinition id="_med_ver" messageRef="_msg_verification"/>
      </bpmn2:startEvent>
      <bpmn2:userTask id="ev_ver_task" name="Complete additional verification" drools:taskName="CompleteAdditionalVerification">
        <bpmn2:incoming>ev1</bpmn2:incoming>
        <bpmn2:outgoing>ev2</bpmn2:outgoing>
        <bpmn2:potentialOwner id="_po_ver">
          <bpmn2:resourceAssignmentExpression id="_rae_ver">
            <bpmn2:formalExpression>amendments-verification</bpmn2:formalExpression>
          </bpmn2:resourceAssignmentExpression>
        </bpmn2:potentialOwner>
      </bpmn2:userTask>
      <bpmn2:endEvent id="ev_ver_end">
        <bpmn2:incoming>ev2</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="ev1" sourceRef="ev_ver_start" targetRef="ev_ver_task"/>
      <bpmn2:sequenceFlow id="ev2" sourceRef="ev_ver_task" targetRef="ev_ver_end"/>
    </bpmn2:subProcess>

    <bpmn2:subProcess id="evsub_cancel" name="Customer cancellation" triggeredByEvent="true">
      <bpmn2:startEvent id="ev_can_start" name="Cancellation received" isInterrupting="true">
        <bpmn2:outgoing>ec1</bpmn2:outgoing>
        
        <bpmn2:dataOutput id="_do_ev_can_start" name="_do_ev_can_start"/>
        <bpmn2:dataOutputAssociation>
          <bpmn2:sourceRef>_do_ev_can_start</bpmn2:sourceRef>
          <bpmn2:targetRef>requestId</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_ev_can_start</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
        <bpmn2:messageEventDefinition id="_med_can" messageRef="_msg_cancel"/>
      </bpmn2:startEvent>
      <bpmn2:task id="ev_can_task" name="Roll back and close request" drools:taskName="RequestCancellationTask">
        <bpmn2:incoming>ec1</bpmn2:incoming>
        <bpmn2:outgoing>ec2</bpmn2:outgoing>
    </bpmn2:task>
      <bpmn2:endEvent id="ev_can_end" name="Request cancelled">
        <bpmn2:incoming>ec2</bpmn2:incoming>
        <bpmn2:terminateEventDefinition id="_ted_can"/>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="ec1" sourceRef="ev_can_start" targetRef="ev_can_task"/>
      <bpmn2:sequenceFlow id="ec2" sourceRef="ev_can_task" targetRef="ev_can_end"/>
    </bpmn2:subProcess>

    <bpmn2:subProcess id="evsub_sla" name="SLA escalation" triggeredByEvent="true">
      <bpmn2:startEvent id="ev_sla_start" name="SLA breached" isInterrupting="false">
        <bpmn2:outgoing>es1</bpmn2:outgoing>
        <bpmn2:signalEventDefinition id="_sed_sla" signalRef="_sig_sla"/>
      </bpmn2:startEvent>
      <bpmn2:task id="ev_sla_task" name="Escalate to operations" drools:taskName="SlaEscalationTask">
        <bpmn2:incoming>es1</bpmn2:incoming>
        <bpmn2:outgoing>es2</bpmn2:outgoing>
    </bpmn2:task>
      <bpmn2:endEvent id="ev_sla_end">
        <bpmn2:incoming>es2</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="es1" sourceRef="ev_sla_start" targetRef="ev_sla_task"/>
      <bpmn2:sequenceFlow id="es2" sourceRef="ev_sla_task" targetRef="ev_sla_end"/>
    </bpmn2:subProcess>

  </bpmn2:process>
