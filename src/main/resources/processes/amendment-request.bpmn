<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="_amendment_request_defs"
                   targetNamespace="https://bank.com/bpmn/amendments"
                   exporter="Manual"
                   exporterVersion="1.0">

  <bpmn2:itemDefinition id="_itemRequest" structureRef="com.bank.amendments.model.AmendmentRequest"/>
  <bpmn2:itemDefinition id="_itemString" structureRef="String"/>
  <bpmn2:itemDefinition id="_itemBoolean" structureRef="Boolean"/>
  <bpmn2:itemDefinition id="_itemItem" structureRef="com.bank.amendments.model.AmendmentItem"/>

  <bpmn2:message id="_msg_document" name="ExtraDocumentSubmitted" itemRef="_itemString"/>
  <bpmn2:message id="_msg_verification" name="AdditionalVerificationRequired" itemRef="_itemString"/>
  <bpmn2:message id="_msg_cancel" name="AmendmentCancelled" itemRef="_itemString"/>

  <bpmn2:process id="amendment-request"
                 name="Amendment Request"
                 isExecutable="true"
                 processType="Public">

    <bpmn2:property id="request" itemSubjectRef="_itemRequest" name="request"/>
    <bpmn2:property id="requestId" itemSubjectRef="_itemString" name="requestId"/>
    <bpmn2:property id="cancelled" itemSubjectRef="_itemBoolean" name="cancelled"/>

    <bpmn2:startEvent id="start" name="Request submitted">
      <bpmn2:outgoing>f1</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:serviceTask id="task_intake"
                       name="Load account and verify identity"
                       implementation="##WebService"
                       operationRef="_op_intake">
      <bpmn2:incoming>f1</bpmn2:incoming>
      <bpmn2:outgoing>f2</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_ios_intake">
        <bpmn2:dataInput id="_di_intake" itemSubjectRef="_itemRequest" name="request"/>
        <bpmn2:dataOutput id="_do_intake" itemSubjectRef="_itemRequest" name="request"/>
        <bpmn2:inputSet id="_is_intake"><bpmn2:dataInputRefs>_di_intake</bpmn2:dataInputRefs></bpmn2:inputSet>
        <bpmn2:outputSet id="_os_intake"><bpmn2:dataOutputRefs>_do_intake</bpmn2:dataOutputRefs></bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="_dia_intake">
        <bpmn2:sourceRef>request</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_intake</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_doa_intake">
        <bpmn2:sourceRef>_do_intake</bpmn2:sourceRef>
        <bpmn2:targetRef>request</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:serviceTask>

    <bpmn2:serviceTask id="task_screening"
                       name="Sanctions and PEP screening"
                       implementation="##WebService"
                       operationRef="_op_screening">
      <bpmn2:incoming>f2</bpmn2:incoming>
      <bpmn2:outgoing>f3</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_ios_scr">
        <bpmn2:dataInput id="_di_scr" itemSubjectRef="_itemRequest" name="request"/>
        <bpmn2:dataOutput id="_do_scr" itemSubjectRef="_itemRequest" name="request"/>
        <bpmn2:inputSet id="_is_scr"><bpmn2:dataInputRefs>_di_scr</bpmn2:dataInputRefs></bpmn2:inputSet>
        <bpmn2:outputSet id="_os_scr"><bpmn2:dataOutputRefs>_do_scr</bpmn2:dataOutputRefs></bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="_dia_scr">
        <bpmn2:sourceRef>request</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_scr</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_doa_scr">
        <bpmn2:sourceRef>_do_scr</bpmn2:sourceRef>
        <bpmn2:targetRef>request</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:serviceTask>

    <bpmn2:businessRuleTask id="task_admissibility"
                            name="Assess admissibility"
                            implementation="http://www.jboss.org/drools/dmn">
      <bpmn2:extensionElements>
        <drools:metaData name="namespace"><drools:metaValue>https://bank.com/dmn/amendments</drools:metaValue></drools:metaData>
        <drools:metaData name="model"><drools:metaValue>AmendmentAdmissibility</drools:metaValue></drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f3</bpmn2:incoming>
      <bpmn2:outgoing>f4</bpmn2:outgoing>
    </bpmn2:businessRuleTask>

    <bpmn2:businessRuleTask id="task_sequencing"
                            name="Determine execution plan"
                            implementation="http://www.jboss.org/drools/dmn">
      <bpmn2:extensionElements>
        <drools:metaData name="namespace"><drools:metaValue>https://bank.com/dmn/amendments</drools:metaValue></drools:metaData>
        <drools:metaData name="model"><drools:metaValue>AmendmentSequencing</drools:metaValue></drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>f4</bpmn2:incoming>
      <bpmn2:outgoing>f5</bpmn2:outgoing>
    </bpmn2:businessRuleTask>

    <bpmn2:exclusiveGateway id="gw_any_permitted" name="Any permitted" gatewayDirection="Diverging">
      <bpmn2:incoming>f5</bpmn2:incoming>
      <bpmn2:outgoing>f6</bpmn2:outgoing>
      <bpmn2:outgoing>f_refuse</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:subProcess id="sub_dispatch" name="Execute permitted amendments">
      <bpmn2:incoming>f6</bpmn2:incoming>
      <bpmn2:outgoing>f7</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics id="_mi_dispatch" isSequential="false">
        <bpmn2:loopDataInputRef>request</bpmn2:loopDataInputRef>
      </bpmn2:multiInstanceLoopCharacteristics>

      <bpmn2:startEvent id="sub_start">
        <bpmn2:outgoing>sf1</bpmn2:outgoing>
      </bpmn2:startEvent>

      <bpmn2:exclusiveGateway id="gw_type" name="Amendment type" gatewayDirection="Diverging">
        <bpmn2:incoming>sf1</bpmn2:incoming>
        <bpmn2:outgoing>sf_coa</bpmn2:outgoing>
        <bpmn2:outgoing>sf_con</bpmn2:outgoing>
        <bpmn2:outgoing>sf_jts</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>

      <bpmn2:callActivity id="call_coa" name="Change of address" calledElement="amendment-coa">
        <bpmn2:incoming>sf_coa</bpmn2:incoming>
        <bpmn2:outgoing>sf_coa_out</bpmn2:outgoing>
      </bpmn2:callActivity>

      <bpmn2:callActivity id="call_con" name="Change of name" calledElement="amendment-con">
        <bpmn2:incoming>sf_con</bpmn2:incoming>
        <bpmn2:outgoing>sf_con_out</bpmn2:outgoing>
      </bpmn2:callActivity>

      <bpmn2:callActivity id="call_jts" name="Joint to sole" calledElement="amendment-joint-to-sole">
        <bpmn2:incoming>sf_jts</bpmn2:incoming>
        <bpmn2:outgoing>sf_jts_out</bpmn2:outgoing>
      </bpmn2:callActivity>

      <bpmn2:exclusiveGateway id="gw_type_join" name="Join" gatewayDirection="Converging">
        <bpmn2:incoming>sf_coa_out</bpmn2:incoming>
        <bpmn2:incoming>sf_con_out</bpmn2:incoming>
        <bpmn2:incoming>sf_jts_out</bpmn2:incoming>
        <bpmn2:outgoing>sf_end</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>

      <bpmn2:endEvent id="sub_end">
        <bpmn2:incoming>sf_end</bpmn2:incoming>
      </bpmn2:endEvent>

      <bpmn2:sequenceFlow id="sf1" sourceRef="sub_start" targetRef="gw_type"/>
      <bpmn2:sequenceFlow id="sf_coa" sourceRef="gw_type" targetRef="call_coa">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">item.type = "COA"</bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="sf_con" sourceRef="gw_type" targetRef="call_con">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">item.type = "CON"</bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="sf_jts" sourceRef="gw_type" targetRef="call_jts">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">item.type = "JOINT_TO_SOLE"</bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="sf_coa_out" sourceRef="call_coa" targetRef="gw_type_join"/>
      <bpmn2:sequenceFlow id="sf_con_out" sourceRef="call_con" targetRef="gw_type_join"/>
      <bpmn2:sequenceFlow id="sf_jts_out" sourceRef="call_jts" targetRef="gw_type_join"/>
      <bpmn2:sequenceFlow id="sf_end" sourceRef="gw_type_join" targetRef="sub_end"/>
    </bpmn2:subProcess>

    <bpmn2:serviceTask id="task_aggregate"
                       name="Aggregate outcomes and notify customer"
                       implementation="##WebService"
                       operationRef="_op_notify">
      <bpmn2:incoming>f7</bpmn2:incoming>
      <bpmn2:incoming>f_refuse</bpmn2:incoming>
      <bpmn2:outgoing>f8</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:endEvent id="end" name="Request closed">
      <bpmn2:incoming>f8</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="f1" sourceRef="start" targetRef="task_intake"/>
    <bpmn2:sequenceFlow id="f2" sourceRef="task_intake" targetRef="task_screening"/>
    <bpmn2:sequenceFlow id="f3" sourceRef="task_screening" targetRef="task_admissibility"/>
    <bpmn2:sequenceFlow id="f4" sourceRef="task_admissibility" targetRef="task_sequencing"/>
    <bpmn2:sequenceFlow id="f5" sourceRef="task_sequencing" targetRef="gw_any_permitted"/>
    <bpmn2:sequenceFlow id="f6" sourceRef="gw_any_permitted" targetRef="sub_dispatch">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">count(request.items[admissibility != "REFUSED"]) > 0</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="f_refuse" sourceRef="gw_any_permitted" targetRef="task_aggregate">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">count(request.items[admissibility != "REFUSED"]) = 0</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="f7" sourceRef="sub_dispatch" targetRef="task_aggregate"/>
    <bpmn2:sequenceFlow id="f8" sourceRef="task_aggregate" targetRef="end"/>

    <bpmn2:subProcess id="evsub_document" name="Extra document received" triggeredByEvent="true">
      <bpmn2:startEvent id="ev_doc_start" name="Document submitted" isInterrupting="false">
        <bpmn2:outgoing>ed1</bpmn2:outgoing>
        <bpmn2:messageEventDefinition id="_med_doc" messageRef="_msg_document"/>
      </bpmn2:startEvent>
      <bpmn2:serviceTask id="ev_doc_task" name="Attach and verify document"
                         implementation="##WebService" operationRef="_op_document">
        <bpmn2:incoming>ed1</bpmn2:incoming>
        <bpmn2:outgoing>ed2</bpmn2:outgoing>
      </bpmn2:serviceTask>
      <bpmn2:endEvent id="ev_doc_end">
        <bpmn2:incoming>ed2</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="ed1" sourceRef="ev_doc_start" targetRef="ev_doc_task"/>
      <bpmn2:sequenceFlow id="ed2" sourceRef="ev_doc_task" targetRef="ev_doc_end"/>
    </bpmn2:subProcess>

    <bpmn2:subProcess id="evsub_verification" name="Additional verification" triggeredByEvent="true">
      <bpmn2:startEvent id="ev_ver_start" name="Verification required" isInterrupting="false">
        <bpmn2:outgoing>ev1</bpmn2:outgoing>
        <bpmn2:messageEventDefinition id="_med_ver" messageRef="_msg_verification"/>
      </bpmn2:startEvent>
      <bpmn2:userTask id="ev_ver_task" name="Complete additional verification">
        <bpmn2:incoming>ev1</bpmn2:incoming>
        <bpmn2:outgoing>ev2</bpmn2:outgoing>
        <bpmn2:potentialOwner id="_po_ver">
          <bpmn2:resourceAssignmentExpression id="_rae_ver">
            <bpmn2:formalExpression>amendments-verification</bpmn2:formalExpression>
          </bpmn2:resourceAssignmentExpression>
        </bpmn2:potentialOwner>
      </bpmn2:userTask>
      <bpmn2:endEvent id="ev_ver_end">
        <bpmn2:incoming>ev2</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="ev1" sourceRef="ev_ver_start" targetRef="ev_ver_task"/>
      <bpmn2:sequenceFlow id="ev2" sourceRef="ev_ver_task" targetRef="ev_ver_end"/>
    </bpmn2:subProcess>

    <bpmn2:subProcess id="evsub_cancel" name="Customer cancellation" triggeredByEvent="true">
      <bpmn2:startEvent id="ev_can_start" name="Cancellation received" isInterrupting="true">
        <bpmn2:outgoing>ec1</bpmn2:outgoing>
        <bpmn2:messageEventDefinition id="_med_can" messageRef="_msg_cancel"/>
      </bpmn2:startEvent>
      <bpmn2:serviceTask id="ev_can_task" name="Roll back and close request"
                         implementation="##WebService" operationRef="_op_cancel">
        <bpmn2:incoming>ec1</bpmn2:incoming>
        <bpmn2:outgoing>ec2</bpmn2:outgoing>
      </bpmn2:serviceTask>
      <bpmn2:endEvent id="ev_can_end" name="Request cancelled">
        <bpmn2:incoming>ec2</bpmn2:incoming>
        <bpmn2:terminateEventDefinition id="_ted_can"/>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="ec1" sourceRef="ev_can_start" targetRef="ev_can_task"/>
      <bpmn2:sequenceFlow id="ec2" sourceRef="ev_can_task" targetRef="ev_can_end"/>
    </bpmn2:subProcess>

    <bpmn2:subProcess id="evsub_sla" name="SLA escalation" triggeredByEvent="true">
      <bpmn2:startEvent id="ev_sla_start" name="SLA breached" isInterrupting="false">
        <bpmn2:outgoing>es1</bpmn2:outgoing>
        <bpmn2:timerEventDefinition id="_ted_sla">
          <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">PT120H</bpmn2:timeDuration>
        </bpmn2:timerEventDefinition>
      </bpmn2:startEvent>
      <bpmn2:serviceTask id="ev_sla_task" name="Escalate to operations"
                         implementation="##WebService" operationRef="_op_escalate">
        <bpmn2:incoming>es1</bpmn2:incoming>
        <bpmn2:outgoing>es2</bpmn2:outgoing>
      </bpmn2:serviceTask>
      <bpmn2:endEvent id="ev_sla_end">
        <bpmn2:incoming>es2</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="es1" sourceRef="ev_sla_start" targetRef="ev_sla_task"/>
      <bpmn2:sequenceFlow id="es2" sourceRef="ev_sla_task" targetRef="ev_sla_end"/>
    </bpmn2:subProcess>

  </bpmn2:process>

  <bpmndi:BPMNDiagram id="_diag_amendment">
    <bpmndi:BPMNPlane id="_plane_amendment" bpmnElement="amendment-request">
      <bpmndi:BPMNShape id="_s_start" bpmnElement="start"><dc:Bounds x="60" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_intake" bpmnElement="task_intake"><dc:Bounds x="140" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_scr" bpmnElement="task_screening"><dc:Bounds x="300" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_adm" bpmnElement="task_admissibility"><dc:Bounds x="460" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_seq" bpmnElement="task_sequencing"><dc:Bounds x="620" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_gw" bpmnElement="gw_any_permitted"><dc:Bounds x="780" y="118" width="40" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_sub" bpmnElement="sub_dispatch"><dc:Bounds x="860" y="60" width="360" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_agg" bpmnElement="task_aggregate"><dc:Bounds x="1260" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_end" bpmnElement="end"><dc:Bounds x="1420" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_evdoc" bpmnElement="evsub_document"><dc:Bounds x="140" y="280" width="280" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_evver" bpmnElement="evsub_verification"><dc:Bounds x="460" y="280" width="280" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_evcan" bpmnElement="evsub_cancel"><dc:Bounds x="780" y="280" width="280" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_s_evsla" bpmnElement="evsub_sla"><dc:Bounds x="1100" y="280" width="280" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="_e_f1" bpmnElement="f1"><di:waypoint x="96" y="138"/><di:waypoint x="140" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_e_f2" bpmnElement="f2"><di:waypoint x="260" y="138"/><di:waypoint x="300" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_e_f3" bpmnElement="f3"><di:waypoint x="420" y="138"/><di:waypoint x="460" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_e_f4" bpmnElement="f4"><di:waypoint x="580" y="138"/><di:waypoint x="620" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_e_f5" bpmnElement="f5"><di:waypoint x="740" y="138"/><di:waypoint x="780" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_e_f6" bpmnElement="f6"><di:waypoint x="820" y="138"/><di:waypoint x="860" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_e_f7" bpmnElement="f7"><di:waypoint x="1220" y="138"/><di:waypoint x="1260" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_e_f8" bpmnElement="f8"><di:waypoint x="1380" y="138"/><di:waypoint x="1420" y="138"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_e_frefuse" bpmnElement="f_refuse"><di:waypoint x="800" y="158"/><di:waypoint x="800" y="240"/><di:waypoint x="1320" y="240"/><di:waypoint x="1320" y="178"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
