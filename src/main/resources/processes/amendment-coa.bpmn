<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="_coa_defs"
                   targetNamespace="https://bank.com/bpmn/amendments"
                   exporter="Manual" exporterVersion="1.0">

  <bpmn2:itemDefinition id="_c_itemItem" structureRef="com.bank.amendments.model.AmendmentItem"/>
  <bpmn2:itemDefinition id="_c_itemString" structureRef="String"/>
  <bpmn2:message id="_c_msg_evidence" name="CoaEvidenceSubmitted" itemRef="_c_itemString"/>

  <bpmn2:process id="amendment-coa" name="Change of Address" isExecutable="true" processType="Public">

    <bpmn2:property id="item" itemSubjectRef="_c_itemItem" name="item"/>
    <bpmn2:property id="requestId" itemSubjectRef="_c_itemString" name="requestId"/>

    <bpmn2:startEvent id="c_start" name="Start"><bpmn2:outgoing>cf1</bpmn2:outgoing></bpmn2:startEvent>

    <bpmn2:serviceTask id="c_validate" name="Validate and normalise address"
                       implementation="##WebService" operationRef="_op_addr_validate">
      <bpmn2:incoming>cf1</bpmn2:incoming><bpmn2:outgoing>cf2</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:serviceTask id="c_verify" name="Third party address verification"
                       implementation="##WebService" operationRef="_op_addr_verify">
      <bpmn2:incoming>cf2</bpmn2:incoming><bpmn2:outgoing>cf3</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:exclusiveGateway id="c_gw_verified" name="Verified" gatewayDirection="Diverging">
      <bpmn2:incoming>cf3</bpmn2:incoming>
      <bpmn2:outgoing>cf_ok</bpmn2:outgoing>
      <bpmn2:outgoing>cf_evidence</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:userTask id="c_evidence" name="Request proof of address">
      <bpmn2:incoming>cf_evidence</bpmn2:incoming><bpmn2:outgoing>cf_evidence_out</bpmn2:outgoing>
      <bpmn2:potentialOwner id="_c_po">
        <bpmn2:resourceAssignmentExpression id="_c_rae">
          <bpmn2:formalExpression>amendments-ops</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
      <bpmn2:boundaryEventRefs>c_evidence_timer</bpmn2:boundaryEventRefs>
    </bpmn2:userTask>

    <bpmn2:boundaryEvent id="c_evidence_timer" name="Evidence SLA" attachedToRef="c_evidence" cancelActivity="false">
      <bpmn2:outgoing>cf_timer</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="_c_ted">
        <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">PT72H</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:boundaryEvent>

    <bpmn2:serviceTask id="c_remind" name="Send evidence reminder"
                       implementation="##WebService" operationRef="_op_notify">
      <bpmn2:incoming>cf_timer</bpmn2:incoming><bpmn2:outgoing>cf_remind_out</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:endEvent id="c_remind_end"><bpmn2:incoming>cf_remind_out</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:exclusiveGateway id="c_gw_join" name="Join" gatewayDirection="Converging">
      <bpmn2:incoming>cf_ok</bpmn2:incoming>
      <bpmn2:incoming>cf_evidence_out</bpmn2:incoming>
      <bpmn2:outgoing>cf4</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:serviceTask id="c_tax" name="Assess tax residency impact"
                       implementation="##WebService" operationRef="_op_tax">
      <bpmn2:incoming>cf4</bpmn2:incoming><bpmn2:outgoing>cf5</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:serviceTask id="c_apply" name="Apply address in core banking"
                       implementation="##WebService" operationRef="_op_core_address">
      <bpmn2:incoming>cf5</bpmn2:incoming><bpmn2:outgoing>cf6</bpmn2:outgoing>
      <bpmn2:boundaryEventRefs>c_apply_error</bpmn2:boundaryEventRefs>
    </bpmn2:serviceTask>

    <bpmn2:boundaryEvent id="c_apply_error" name="Core failure" attachedToRef="c_apply" cancelActivity="true">
      <bpmn2:outgoing>cf_err</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="_c_eed" errorRef="_c_err"/>
    </bpmn2:boundaryEvent>

    <bpmn2:serviceTask id="c_compensate" name="Record failure and refer"
                       implementation="##WebService" operationRef="_op_fail">
      <bpmn2:incoming>cf_err</bpmn2:incoming><bpmn2:outgoing>cf_err_out</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:endEvent id="c_end_failed" name="Failed"><bpmn2:incoming>cf_err_out</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:endEvent id="c_end" name="Applied"><bpmn2:incoming>cf6</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:sequenceFlow id="cf1" sourceRef="c_start" targetRef="c_validate"/>
    <bpmn2:sequenceFlow id="cf2" sourceRef="c_validate" targetRef="c_verify"/>
    <bpmn2:sequenceFlow id="cf3" sourceRef="c_verify" targetRef="c_gw_verified"/>
    <bpmn2:sequenceFlow id="cf_ok" sourceRef="c_gw_verified" targetRef="c_gw_join">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">item.coa.addressVerified = true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="cf_evidence" sourceRef="c_gw_verified" targetRef="c_evidence">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">item.coa.addressVerified = false</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="cf_evidence_out" sourceRef="c_evidence" targetRef="c_gw_join"/>
    <bpmn2:sequenceFlow id="cf_timer" sourceRef="c_evidence_timer" targetRef="c_remind"/>
    <bpmn2:sequenceFlow id="cf_remind_out" sourceRef="c_remind" targetRef="c_remind_end"/>
    <bpmn2:sequenceFlow id="cf4" sourceRef="c_gw_join" targetRef="c_tax"/>
    <bpmn2:sequenceFlow id="cf5" sourceRef="c_tax" targetRef="c_apply"/>
    <bpmn2:sequenceFlow id="cf6" sourceRef="c_apply" targetRef="c_end"/>
    <bpmn2:sequenceFlow id="cf_err" sourceRef="c_apply_error" targetRef="c_compensate"/>
    <bpmn2:sequenceFlow id="cf_err_out" sourceRef="c_compensate" targetRef="c_end_failed"/>
  </bpmn2:process>

  <bpmn2:error id="_c_err" errorCode="CORE_BANKING_FAILURE" name="CoreBankingFailure"/>

  <bpmndi:BPMNDiagram id="_c_diag">
    <bpmndi:BPMNPlane id="_c_plane" bpmnElement="amendment-coa">
      <bpmndi:BPMNShape id="_cs_start" bpmnElement="c_start"><dc:Bounds x="60" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_cs_val" bpmnElement="c_validate"><dc:Bounds x="140" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_cs_ver" bpmnElement="c_verify"><dc:Bounds x="300" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_cs_gw" bpmnElement="c_gw_verified"><dc:Bounds x="460" y="118" width="40" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_cs_ev" bpmnElement="c_evidence"><dc:Bounds x="540" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_cs_join" bpmnElement="c_gw_join"><dc:Bounds x="700" y="118" width="40" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_cs_tax" bpmnElement="c_tax"><dc:Bounds x="780" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_cs_apply" bpmnElement="c_apply"><dc:Bounds x="940" y="98" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_cs_end" bpmnElement="c_end"><dc:Bounds x="1100" y="120" width="36" height="36"/></bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
