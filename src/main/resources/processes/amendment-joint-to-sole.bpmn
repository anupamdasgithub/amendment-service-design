<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="_jts_defs"
                   targetNamespace="https://bank.com/bpmn/amendments"
                   exporter="Manual" exporterVersion="1.0">

  <bpmn2:itemDefinition id="_j_itemItem" structureRef="com.bank.amendments.model.AmendmentItem"/>
  <bpmn2:itemDefinition id="_j_itemString" structureRef="String"/>
  <bpmn2:message id="_j_msg_dispute" name="ConsentDisputed" itemRef="_j_itemString"/>
  <bpmn2:message id="_j_msg_consent" name="ConsentResponseReceived" itemRef="_j_itemString"/>

  <bpmn2:error id="_j_err" errorCode="CORE_BANKING_FAILURE" name="CoreBankingFailure"/>


  <bpmn2:process id="amendment_joint_to_sole" name="Joint to Sole Conversion" isExecutable="true" processType="Public">

    <bpmn2:property id="allConsentsGranted"/>
    <bpmn2:property id="jtsDiverted"/>
    <bpmn2:property id="jtsReviewRequired"/>
    <bpmn2:property id="jtsEligible"/>
    <bpmn2:property id="JtsEligibility"/>
    <bpmn2:property id="accountId"/>
    <bpmn2:property id="item" itemSubjectRef="_j_itemItem" name="item">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="requestId" itemSubjectRef="_j_itemString" name="requestId">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>

    <bpmn2:startEvent id="j_start" name="Start"><bpmn2:outgoing>jf1</bpmn2:outgoing></bpmn2:startEvent>

    <bpmn2:task id="j_parties" name="Resolve parties and liabilities" drools:taskName="PartyResolutionTask">
      <bpmn2:incoming>jf1</bpmn2:incoming><bpmn2:outgoing>jf2</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:businessRuleTask id="j_eligibility" name="Assess conversion eligibility"
                            implementation="http://www.jboss.org/drools/dmn">
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_di_j_eligibility_0" name="namespace"/>
        <bpmn2:dataInput id="_di_j_eligibility_1" name="model"/>
        <bpmn2:dataInput id="_di_j_eligibility_2" name="decision"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_di_j_eligibility_0</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_j_eligibility_1</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_j_eligibility_2</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet/>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_j_eligibility_0</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[https://bank.com/dmn/amendments]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_j_eligibility_0]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_j_eligibility_1</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[JointToSoleEligibility]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_j_eligibility_1]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_j_eligibility_2</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[JtsEligibility]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_j_eligibility_2]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:incoming>jf2</bpmn2:incoming><bpmn2:outgoing>jf3</bpmn2:outgoing>
    </bpmn2:businessRuleTask>

    <bpmn2:exclusiveGateway id="j_gw_elig" name="Eligibility outcome" gatewayDirection="Diverging">
      <bpmn2:incoming>jf3</bpmn2:incoming>
      <bpmn2:outgoing>jf_divert</bpmn2:outgoing>
      <bpmn2:outgoing>jf_review</bpmn2:outgoing>
      <bpmn2:outgoing>jf_consent</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:task id="j_divert" name="Divert to specialist journey" drools:taskName="JourneyDiversionTask">
      <bpmn2:incoming>jf_divert</bpmn2:incoming><bpmn2:outgoing>jf_divert_out</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:endEvent id="j_end_divert" name="Diverted"><bpmn2:incoming>jf_divert_out</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:userTask id="j_review" name="Underwriting review" drools:taskName="UnderwritingReview">
      <bpmn2:incoming>jf_review</bpmn2:incoming><bpmn2:outgoing>jf_review_out</bpmn2:outgoing>
      <bpmn2:potentialOwner id="_j_po1">
        <bpmn2:resourceAssignmentExpression id="_j_rae1">
          <bpmn2:formalExpression>underwriting</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
    </bpmn2:userTask>

    <bpmn2:exclusiveGateway id="j_gw_consent_join" name="Proceed to consent" gatewayDirection="Converging">
      <bpmn2:incoming>jf_consent</bpmn2:incoming>
      <bpmn2:incoming>jf_review_out</bpmn2:incoming>
      <bpmn2:outgoing>jf4</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:subProcess id="j_consent_loop" name="Collect party consent">
      <bpmn2:incoming>jf4</bpmn2:incoming><bpmn2:outgoing>jf5</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics id="_j_mi" isSequential="false"/>

      <bpmn2:startEvent id="j_c_start"><bpmn2:outgoing>jc1</bpmn2:outgoing></bpmn2:startEvent>

      <bpmn2:task id="j_c_request" name="Request consent from party" drools:taskName="ConsentRequestTask">
        <bpmn2:incoming>jc1</bpmn2:incoming><bpmn2:outgoing>jc2</bpmn2:outgoing>
    </bpmn2:task>

      <!--
        Receive Task rather than an intermediate catch event: the engine only
        permits boundary events on activities, and this wait needs the
        consent-expiry timer attached to it.
      -->
      <bpmn2:receiveTask id="j_c_wait" name="Await consent response"
                         messageRef="_j_msg_consent">
        <bpmn2:incoming>jc2</bpmn2:incoming><bpmn2:outgoing>jc3</bpmn2:outgoing>
        <bpmn2:ioSpecification>
          <bpmn2:dataOutput id="_do_j_c_wait" name="_do_j_c_wait"/>
          <bpmn2:inputSet/>
          <bpmn2:outputSet>
            <bpmn2:dataOutputRefs>_do_j_c_wait</bpmn2:dataOutputRefs>
          </bpmn2:outputSet>
        </bpmn2:ioSpecification>
        <bpmn2:dataOutputAssociation>
          <bpmn2:sourceRef>_do_j_c_wait</bpmn2:sourceRef>
          <bpmn2:targetRef>requestId</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
      </bpmn2:receiveTask>

      <bpmn2:boundaryEvent id="j_c_expiry" name="Consent expiry" attachedToRef="j_c_wait" cancelActivity="true">
        <bpmn2:outgoing>jc_exp</bpmn2:outgoing>
        <bpmn2:timerEventDefinition id="_j_ted_c">
          <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">PT336H</bpmn2:timeDuration>
        </bpmn2:timerEventDefinition>
      </bpmn2:boundaryEvent>

      <bpmn2:task id="j_c_expire" name="Mark consent expired" drools:taskName="ConsentExpiryTask">
        <bpmn2:incoming>jc_exp</bpmn2:incoming><bpmn2:outgoing>jc_exp_out</bpmn2:outgoing>
    </bpmn2:task>
      <bpmn2:endEvent id="j_c_end_exp"><bpmn2:incoming>jc_exp_out</bpmn2:incoming></bpmn2:endEvent>

      <bpmn2:endEvent id="j_c_end"><bpmn2:incoming>jc3</bpmn2:incoming></bpmn2:endEvent>

      <bpmn2:sequenceFlow id="jc1" sourceRef="j_c_start" targetRef="j_c_request"/>
      <bpmn2:sequenceFlow id="jc2" sourceRef="j_c_request" targetRef="j_c_wait"/>
      <bpmn2:sequenceFlow id="jc3" sourceRef="j_c_wait" targetRef="j_c_end"/>
      <bpmn2:sequenceFlow id="jc_exp" sourceRef="j_c_expiry" targetRef="j_c_expire"/>
      <bpmn2:sequenceFlow id="jc_exp_out" sourceRef="j_c_expire" targetRef="j_c_end_exp"/>
    </bpmn2:subProcess>

    <bpmn2:task id="j_derive" name="Read consent status" drools:taskName="ReadItemDetailTask">
      <bpmn2:incoming>jf5</bpmn2:incoming>
      <bpmn2:outgoing>jf5b</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_di_j_derive_item" name="item"/>
        <bpmn2:dataInput id="_di_j_derive_elig" name="JtsEligibility"/>
        <bpmn2:dataOutput id="_do_j_derive_allConsentsGranted" name="allConsentsGranted"/>
        <bpmn2:dataOutput id="_do_j_derive_jtsDiverted" name="jtsDiverted"/>
        <bpmn2:dataOutput id="_do_j_derive_jtsReviewRequired" name="jtsReviewRequired"/>
        <bpmn2:dataOutput id="_do_j_derive_jtsEligible" name="jtsEligible"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_di_j_derive_item</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_j_derive_elig</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_j_derive_allConsentsGranted</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_j_derive_jtsDiverted</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_j_derive_jtsReviewRequired</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_do_j_derive_jtsEligible</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>item</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_j_derive_item</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>JtsEligibility</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_j_derive_elig</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_j_derive_allConsentsGranted</bpmn2:sourceRef>
        <bpmn2:targetRef>allConsentsGranted</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_j_derive_jtsDiverted</bpmn2:sourceRef>
        <bpmn2:targetRef>jtsDiverted</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_j_derive_jtsReviewRequired</bpmn2:sourceRef>
        <bpmn2:targetRef>jtsReviewRequired</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_do_j_derive_jtsEligible</bpmn2:sourceRef>
        <bpmn2:targetRef>jtsEligible</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>

    <bpmn2:exclusiveGateway id="j_gw_all_consent" name="All consents granted" gatewayDirection="Diverging">
      <bpmn2:incoming>jf5b</bpmn2:incoming>
      <bpmn2:outgoing>jf_granted</bpmn2:outgoing>
      <bpmn2:outgoing>jf_declined</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:task id="j_refuse" name="Record refusal" drools:taskName="FailureRecordingTask">
      <bpmn2:incoming>jf_declined</bpmn2:incoming><bpmn2:outgoing>jf_ref_out</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:endEvent id="j_end_refused" name="Refused"><bpmn2:incoming>jf_ref_out</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:userTask id="j_approve" name="Maker checker approval" drools:taskName="MakerCheckerApproval">
      <bpmn2:incoming>jf_granted</bpmn2:incoming><bpmn2:outgoing>jf6</bpmn2:outgoing>
      <bpmn2:potentialOwner id="_j_po2">
        <bpmn2:resourceAssignmentExpression id="_j_rae2">
          <bpmn2:formalExpression>amendments-checker</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
    </bpmn2:userTask>

    <bpmn2:task id="j_convert" name="Convert account in core banking" drools:taskName="CoreBankingTask">
      <bpmn2:incoming>jf6</bpmn2:incoming><bpmn2:outgoing>jf7</bpmn2:outgoing>
    
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_di_j_convert_item" name="item"/>
        <bpmn2:dataInput id="_di_j_convert_operation" name="operation"/>
        <bpmn2:dataInput id="_di_j_convert_accountId" name="accountId"/>
        <bpmn2:dataInput id="_di_j_convert_idempotencyKey" name="idempotencyKey"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_di_j_convert_item</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_j_convert_operation</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_j_convert_accountId</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_di_j_convert_idempotencyKey</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet/>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>item</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_j_convert_item</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_di_j_convert_operation</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[CONVERT_TO_SOLE]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_di_j_convert_operation]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>accountId</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_j_convert_accountId</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>requestId</bpmn2:sourceRef>
        <bpmn2:targetRef>_di_j_convert_idempotencyKey</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>

    <bpmn2:boundaryEvent id="j_convert_error" name="Core failure" attachedToRef="j_convert" cancelActivity="true">
      <bpmn2:outgoing>jf_err</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="_j_eed" errorRef="_j_err"/>
    </bpmn2:boundaryEvent>

    <bpmn2:task id="j_compensate" name="Compensate and refer" drools:taskName="CompensationTask">
      <bpmn2:incoming>jf_err</bpmn2:incoming><bpmn2:outgoing>jf_err_out</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:endEvent id="j_end_failed" name="Failed"><bpmn2:incoming>jf_err_out</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:endEvent id="j_end" name="Converted"><bpmn2:incoming>jf7</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:sequenceFlow id="jf1" sourceRef="j_start" targetRef="j_parties"/>
    <bpmn2:sequenceFlow id="jf2" sourceRef="j_parties" targetRef="j_eligibility"/>
    <bpmn2:sequenceFlow id="jf3" sourceRef="j_eligibility" targetRef="j_gw_elig"/>
    <bpmn2:sequenceFlow id="jf_divert" sourceRef="j_gw_elig" targetRef="j_divert">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">jtsDiverted = true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="jf_review" sourceRef="j_gw_elig" targetRef="j_review">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">jtsReviewRequired = true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="jf_consent" sourceRef="j_gw_elig" targetRef="j_gw_consent_join">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">jtsEligible = true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="jf_divert_out" sourceRef="j_divert" targetRef="j_end_divert"/>
    <bpmn2:sequenceFlow id="jf_review_out" sourceRef="j_review" targetRef="j_gw_consent_join"/>
    <bpmn2:sequenceFlow id="jf4" sourceRef="j_gw_consent_join" targetRef="j_consent_loop"/>
    <bpmn2:sequenceFlow id="jf5" sourceRef="j_consent_loop" targetRef="j_derive"/>
    <bpmn2:sequenceFlow id="jf5b" sourceRef="j_derive" targetRef="j_gw_all_consent"/>
    <bpmn2:sequenceFlow id="jf_granted" sourceRef="j_gw_all_consent" targetRef="j_approve">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">allConsentsGranted = true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="jf_declined" sourceRef="j_gw_all_consent" targetRef="j_refuse">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.omg.org/spec/FEEL/20140401">allConsentsGranted = false</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="jf_ref_out" sourceRef="j_refuse" targetRef="j_end_refused"/>
    <bpmn2:sequenceFlow id="jf6" sourceRef="j_approve" targetRef="j_convert"/>
    <bpmn2:sequenceFlow id="jf7" sourceRef="j_convert" targetRef="j_end"/>
    <bpmn2:sequenceFlow id="jf_err" sourceRef="j_convert_error" targetRef="j_compensate"/>
    <bpmn2:sequenceFlow id="jf_err_out" sourceRef="j_compensate" targetRef="j_end_failed"/>

    <bpmn2:subProcess id="j_evsub_dispute" name="Party disputes consent" triggeredByEvent="true">
      <bpmn2:startEvent id="j_d_start" name="Dispute raised" isInterrupting="true">
        <bpmn2:outgoing>jd1</bpmn2:outgoing>
        
        <bpmn2:dataOutput id="_do_j_d_start" name="_do_j_d_start"/>
        <bpmn2:dataOutputAssociation>
          <bpmn2:sourceRef>_do_j_d_start</bpmn2:sourceRef>
          <bpmn2:targetRef>requestId</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_do_j_d_start</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
        <bpmn2:messageEventDefinition id="_j_med_d" messageRef="_j_msg_dispute"/>
      </bpmn2:startEvent>
      <bpmn2:userTask id="j_d_task" name="Investigate consent dispute" drools:taskName="InvestigateConsentDispute">
        <bpmn2:incoming>jd1</bpmn2:incoming><bpmn2:outgoing>jd2</bpmn2:outgoing>
        <bpmn2:potentialOwner id="_j_po3">
          <bpmn2:resourceAssignmentExpression id="_j_rae3">
            <bpmn2:formalExpression>disputes</bpmn2:formalExpression>
          </bpmn2:resourceAssignmentExpression>
        </bpmn2:potentialOwner>
      </bpmn2:userTask>
      <bpmn2:endEvent id="j_d_end" name="Conversion halted">
        <bpmn2:incoming>jd2</bpmn2:incoming>
        <bpmn2:terminateEventDefinition id="_j_ted_d"/>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="jd1" sourceRef="j_d_start" targetRef="j_d_task"/>
      <bpmn2:sequenceFlow id="jd2" sourceRef="j_d_task" targetRef="j_d_end"/>
    </bpmn2:subProcess>

  </bpmn2:process>
  <bpmndi:BPMNDiagram id="diag_amendment_joint_to_sole">
    <bpmndi:BPMNPlane id="plane_amendment_joint_to_sole" bpmnElement="amendment_joint_to_sole">
      <bpmndi:BPMNShape id="shape_j_consent_loop" bpmnElement="j_consent_loop" isExpanded="true"><dc:Bounds x="1140" y="80" width="756" height="251"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_j_evsub_dispute" bpmnElement="j_evsub_dispute" isExpanded="true"><dc:Bounds x="60" y="441" width="442" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_j_compensate" bpmnElement="j_compensate"><dc:Bounds x="60" y="80" width="140" height="80"/></bpmndi:BPMNShape>
